# Where the app talks to. The default is the live API; change it to try a local one.
# On the Android emulator your Mac is 10.0.2.2 (e.g. http://10.0.2.2:3072); a real phone needs your Mac's address on the same Wi-Fi.
# EXPO_PUBLIC_API_URL=https://api.rasoipulse.in
#
# Allow plain http:// for a DEBUG build that talks to a local API (never for a release build):
# RP_ALLOW_HTTP=1
