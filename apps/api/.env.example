# Copy to .env and adjust. .env is git-ignored — never commit real credentials.

NODE_ENV=development
API_PORT=3072

# Local MongoDB:      mongodb://127.0.0.1:27017/rasoipulse_dev
# MongoDB Atlas:      mongodb+srv://USER:PASS@cluster.xxxx.mongodb.net/rasoipulse_dev?retryWrites=true&w=majority
#   → use a DEDICATED dev database, not a cluster shared with another project.
MONGODB_URI=mongodb://127.0.0.1:27017/rasoipulse_dev
MONGODB_DB=rasoipulse_dev

# Comma-separated origins allowed to call the API (storefront + admin).
CORS_ORIGINS=http://localhost:3070,http://localhost:3071

# Encrypts payment gateway credentials at rest. CHANGE THIS for production.
ENCRYPTION_KEY=dev-only-insecure-encryption-key-change-me
# Enables the simulated payment gateway for local testing.
ALLOW_MOCK_GATEWAY=true

# The domain stores' Rasoi Pulse addresses live under: a store "acme" opens on acme.<this>.
# Production: your real domain, e.g. rasoipulse.in (no https://). Local development:
# localhost:3070 — then acme.localhost:3070 opens in a browser with no DNS or certificate.
STORE_SUBDOMAIN_BASE=localhost:3070

# The marketing website (apps/website). WEBSITE_URL is its public address (also the base of the
# console's "Preview" links). When it runs on this same machine, WEBSITE_INTERNAL_URL lets the API
# ask it to refresh without going out over the internet. WEBSITE_REVALIDATE_SECRET must match the
# website's own — use a long random value in production.
# WEBSITE_URL=http://localhost:3073
# WEBSITE_INTERNAL_URL=http://127.0.0.1:3073
# WEBSITE_REVALIDATE_SECRET=change-me
