# Copy to .env and adjust. .env is git-ignored — never commit real credentials.

NODE_ENV=development
API_PORT=3072

# Local MongoDB:      mongodb://127.0.0.1:27017/onetap_dev
# MongoDB Atlas:      mongodb+srv://USER:PASS@cluster.xxxx.mongodb.net/onetap_dev?retryWrites=true&w=majority
#   → use a DEDICATED dev database, not a cluster shared with another project.
MONGODB_URI=mongodb://127.0.0.1:27017/onetap_dev
MONGODB_DB=onetap_dev

# Comma-separated origins allowed to call the API (storefront + admin).
CORS_ORIGINS=http://localhost:3070,http://localhost:3071

# Encrypts payment gateway credentials at rest. CHANGE THIS for production.
ENCRYPTION_KEY=dev-only-insecure-encryption-key-change-me
# Enables the simulated payment gateway for local testing.
ALLOW_MOCK_GATEWAY=true
