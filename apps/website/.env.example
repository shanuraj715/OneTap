# Copy to .env.local — every value here is optional.
#
# The API address ships with the app (src/lib/api-config.js). Set these only
# to override it for one deployment.
# NEXT_PUBLIC_API_URL=https://api.example.com
# API_INTERNAL_URL=http://127.0.0.1:3072

# The site's public address, used for canonical links, the sitemap and share
# images when Website → Settings has no "site address" yet.
# NEXT_PUBLIC_SITE_URL=https://tablepe.com

# Must match the API's WEBSITE_REVALIDATE_SECRET — lets the console refresh the
# site the moment something is saved.
# WEBSITE_REVALIDATE_SECRET=change-me
