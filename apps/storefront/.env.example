# Copy to .env.local — every value here is optional.
#
# The API address ships with the app (src/lib/api-config.js): the live platform
# API in production builds, http://localhost:3072 in `pnpm dev`. Set these only
# to override that for one deployment.

# The API's public address (read at build time — rebuild after changing it).
NEXT_PUBLIC_API_URL=http://localhost:3072

# Where the storefront server itself calls the API, when that differs from the
# public address — e.g. the API on the same machine:
# API_INTERNAL_URL=http://127.0.0.1:3072
