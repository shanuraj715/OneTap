{
  "name": "rasoipulse",
  "version": "0.0.0",
  "private": true,
  "description": "Rasoi Pulse — multi-tenant restaurant platform",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:all": "turbo run dev --ui=stream",
    "dev:api": "pnpm --filter @rasoipulse/api dev",
    "dev:storefront": "pnpm --filter @rasoipulse/storefront dev",
    "dev:admin": "pnpm --filter @rasoipulse/admin dev",
    "dev:website": "pnpm --filter @rasoipulse/website dev",
    "db:local": "pnpm --filter @rasoipulse/api db:local",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "seed": "pnpm --filter @rasoipulse/api seed",
    "kill": "lsof -ti tcp:3070 tcp:3071 tcp:3072 tcp:3073 | xargs -r kill -9 || true",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  }
}
